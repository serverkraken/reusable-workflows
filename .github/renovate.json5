{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // Org baseline (schedule, updateNotScheduled, actions automerge/grouping,
  // major review, vulnerability alerts) lives in the shared preset —
  // see serverkraken/renovate-config. Only catalog-specific bits stay here.
  extends: [
    'github>serverkraken/renovate-config',
    'helpers:pinGitHubActionDigests',
  ],
  ignorePaths: [
    'tests/fixtures/**',
  ],
  packageRules: [
    {
      description: 'Initial SHA-pin: bundle all pin updates into one PR',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'pin',
      ],
      groupName: 'Pin all GitHub Actions to SHA',
      automerge: false,
      labels: [
        'dependencies',
        'security',
      ],
    },
    {
      description: 'helm-unittest >=1.1.0 uses plugin.yaml platformHooks, rejected by Helm v3 (lint-helm default v3.16.3)',
      matchDepNames: ['helm-unittest/helm-unittest'],
      allowedVersions: '<1.1.0',
    },
  ],
  customManagers: [
    {
      // NOTE: customManagers still uses `fileMatch` — Renovate's migration
      // tool generates `managerFilePatterns` here, but the validator (and
      // some Renovate runtimes) reject it inside customManagers. Keep
      // `fileMatch` until upstream sorts this out.
      //
      // NOTE: matchStrings are compiled WITHOUT the `m` flag, so `$` means
      // end-of-INPUT, not end-of-line. A trailing `['"]?\s*$` therefore only
      // matches a value on the LAST line of the file and can never match a
      // mid-file `KEY: 'value'` — these four managers never produced a PR
      // until this fix. Terminate on `['"]?\s` (a single following
      // whitespace/newline char) instead; the lazy `\S+?` capture still
      // stops before the closing quote.
      customType: 'regex',
      fileMatch: [
        '^\\.github/workflows/.+\\.ya?ml$',
        '^actions/.+/action\\.ya?ml$',
      ],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*TRIVY_VERSION:\\s*[\'"]?(?<currentValue>\\S+?)[\'"]?\\s',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'aquasecurity/trivy',
      extractVersionTemplate: '^v(?<version>.*)$',
    },
    {
      customType: 'regex',
      fileMatch: [
        '^\\.github/workflows/.+\\.ya?ml$',
        '^actions/.+/action\\.ya?ml$',
      ],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*KIND_VERSION:\\s*[\'"]?(?<currentValue>\\S+?)[\'"]?\\s',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'kubernetes-sigs/kind',
    },
    {
      customType: 'regex',
      fileMatch: [
        '^\\.github/workflows/.+\\.ya?ml$',
        '^actions/.+/action\\.ya?ml$',
      ],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*KUBECTL_VERSION:\\s*[\'"]?(?<currentValue>\\S+?)[\'"]?\\s',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'kubernetes/kubernetes',
    },
    {
      customType: 'regex',
      fileMatch: [
        '^\\.github/workflows/.+\\.ya?ml$',
        '^actions/.+/action\\.ya?ml$',
      ],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*CILIUM_CLI_VERSION:\\s*[\'"]?(?<currentValue>\\S+?)[\'"]?\\s',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'cilium/cilium-cli',
    },
    {
      // Matches the `helm_version:` input default used by lint-helm.yml,
      // helm-publish.yml, and e2e-kind.yml. `[\s\S]*?` spans the
      // description/required/type lines between the input key and its
      // `default:` value without needing a dotall flag.
      customType: 'regex',
      fileMatch: [
        '^\\.github/workflows/.+\\.ya?ml$',
        '^actions/.+/action\\.ya?ml$',
      ],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*helm_version:[\\s\\S]*?default:\\s*[\'"]?(?<currentValue>v\\S+?)[\'"]?\\s',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'helm/helm',
    },
    {
      customType: 'regex',
      fileMatch: ['^\\.github/workflows/lint-helm\\.ya?ml$'],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*HELM_UNITTEST_VERSION:\\s*[\'"]?(?<currentValue>v\\S+?)[\'"]?\\s',
      ],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'helm-unittest/helm-unittest',
    },
  ],
}
