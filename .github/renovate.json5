{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  // Org baseline (schedule, updateNotScheduled, actions automerge/grouping,
  // major review, vulnerability alerts) lives in the shared preset —
  // see serverkraken/renovate-config. Only catalog-specific bits stay here.
  extends: [
    'github>serverkraken/renovate-config',
    'helpers:pinGitHubActionDigests',
  ],
  ignorePaths: [
    'tests/fixtures/**',
  ],
  packageRules: [
    {
      description: 'Initial SHA-pin: bundle all pin updates into one PR',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'pin',
      ],
      groupName: 'Pin all GitHub Actions to SHA',
      automerge: false,
      labels: [
        'dependencies',
        'security',
      ],
    },
    {
      description: 'helm-unittest >=1.1.0 uses plugin.yaml platformHooks, rejected by Helm v3 (lint-helm default v3.16.3)',
      matchDepNames: ['helm-unittest/helm-unittest'],
      allowedVersions: '<1.1.0',
    },
    {
      // Trivy taggt `v0.70.0`, der Pin traegt `0.70.0`. Stand frueher als
      // extractVersionTemplate im namentlichen Trivy-Manager; der generische
      // Manager kennt keine Sonderfaelle, also gehoert es hierher.
      description: 'Trivy tags with a leading v, the pin does not',
      matchDepNames: ['aquasecurity/trivy'],
      extractVersion: '^v(?<version>.*)$',
    },
    {
      // kustomize taggt `kustomize/v5.5.0`. Stand frueher inline im Marker in
      // actions/setup-kube-toolchain/action.yml — der generische Manager liest
      // es dort nicht mehr aus.
      description: 'kustomize tags are prefixed with the module path',
      matchDepNames: ['kubernetes-sigs/kustomize'],
      extractVersion: '^kustomize/v(?<version>.+)$',
    },
  ],
  customManagers: [
    {
      // NOTE: customManagers still uses `fileMatch` — Renovate's migration
      // tool generates `managerFilePatterns` here, but the validator (and
      // some Renovate runtimes) reject it inside customManagers. Keep
      // `fileMatch` until upstream sorts this out.
      //
      // NOTE: matchStrings are compiled WITHOUT the `m` flag, so `$` means
      // end-of-INPUT, not end-of-line. Terminate on `['"]?\s` (a single
      // following whitespace/newline char), never on `['"]?\s*$` — the latter
      // only ever matches a value on the LAST line of a file.
      //
      // EIN generischer Manager statt sechs namentlicher: datasource und
      // depName stehen bereits im Marker selbst, depNameTemplate und
      // datasourceTemplate entfallen deshalb. Ein neues Werkzeug braucht
      // damit nur noch seinen Marker, keinen Eintrag hier — und genau das
      // war die Fehlerquelle: 13 von 21 Markern hatten keinen Manager und
      // wurden nie aktualisiert. tests/conventions/check-renovate-markers.py
      // haelt das fest.
      customType: 'regex',
      fileMatch: [
        '^\\.github/workflows/.+\\.ya?ml$',
        '^actions/.+/action\\.ya?ml$',
      ],
      matchStrings: [
        // Form 1 — einzeilig: KEY_VERSION: 'wert' direkt unter dem Marker.
        // `[^\n]*` schluckt ein optionales `extractVersion=` im Marker; der
        // Wert dafuer steht in packageRules, nicht hier.
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)[^\\n]*\\n\\s*[A-Za-z_]+_VERSION:\\s*[\'"]?(?<currentValue>\\S+?)[\'"]?\\s',
        // Form 2 — mehrzeilig: Input-Default einige Zeilen unter dem Marker.
        // `[\s\S]*?` ueberbrueckt description/required/type ohne dotall-Flag.
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)[^\\n]*\\n\\s*[a-z_]+_version:[\\s\\S]*?default:\\s*[\'"]?(?<currentValue>\\S+?)[\'"]?\\s',
      ],
    },
  ],
}
