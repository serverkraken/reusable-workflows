{{- /*
  prerelease-on-push.yml — auto prerelease build on push to the dev branch.

  Rendered ONLY when the repo carries the `sk-prerelease-on-push` topic
  (onboard-render.sh decides; this template assumes it is being rendered).
  Stack-aware, mirroring prerelease.yml's per-stack build jobs. The trigger
  branch is baked (`develop`) — GitHub does not evaluate expressions in `on:`.
*/ -}}
{{- $pin := .pin -}}
name: prerelease-on-push
on:
  push:
    branches: [develop]

jobs:
{{- /* Audit J-3/J-4: hier stand `$c := index .profile.components 0` — der
     Workflow sah also NUR die erste Komponente. In einem Monorepo baute er
     damit ein Image und liess alle weiteren stillschweigend aus, und weil
     `$c.path` nirgends einfloss, zeigte `dockerfile:` auf `Dockerfile` statt
     auf `services/api/Dockerfile`; `context:` fehlte ganz.

     Nebeneinander gerendert an tests/fixtures/onboard/monorepo-go:

       prerelease.yml            build-services-api    context "services/api"
                                 build-services-worker context "services/worker"
       prerelease-on-push.yml    build                 dockerfile "Dockerfile"

     Der Aufbau spiegelt jetzt prerelease.yml.tmpl: Schleife ueber die
     Komponenten, Job-Suffix aus dem Pfad, Kontext und Dockerfile relativ zur
     Komponente. */ -}}
{{- $any := false -}}
{{- range $i, $c := .profile.components }}
{{- $isRoot := eq $c.path "." -}}
{{- $slug := "" -}}
{{- if ne $c.path "." }}{{ $slug = regexp.Replace "[^A-Za-z0-9_-]" "-" (strings.ReplaceAll "/" "-" $c.path) }}{{ end -}}
{{- $suffix := "" -}}
{{- if $slug }}{{ $suffix = printf "-%s" $slug }}{{ end -}}
{{- if and (has $c.release_signals "flutter_android") $c.release_signals.flutter_android }}
{{- $any = true }}
  build{{ $suffix }}:
    uses: serverkraken/reusable-workflows/.github/workflows/release-flutter-android.yml@{{ $pin }}
    secrets: inherit
    with:
      version: ''
      create_release: true
      prerelease: true
      dart_define_secret_names: {{`${{ vars.SK_FLUTTER_DART_DEFINE_SECRETS || '' }}`}}
{{- else if gt (len $c.dockerfiles) 0 }}
{{- $any = true }}
{{- /* One build+scan pair per Dockerfile, mirroring release.yml.tmpl. The
     multi-image path here used to be a single docker-build-multi call; that
     atom exposes no per-image outputs, so nothing could be scanned and every
     image this workflow pushed on a `develop` push shipped unscanned. This is
     the branch adopters push to most often. */ -}}
{{- range $idx, $df := $c.dockerfiles }}
{{- $imgSuffix := "" }}
{{- if gt (len $c.dockerfiles) 1 }}
  {{- $base := path.Base $df.image_name -}}
  {{- $base = regexp.Replace "[$]" "" $base -}}
  {{- $base = regexp.Replace "[^A-Za-z0-9_-]" "-" $base -}}
  {{- $imgSuffix = printf "-%s" (strings.ToLower $base) -}}
{{- end }}
{{- $ctx := $c.path }}{{ if (index $df "context") }}{{ $ctx = index $df "context" }}{{ end }}
{{- if gt $idx 0 }}
{{ end }}
  build{{ $suffix }}{{ $imgSuffix }}:
    uses: serverkraken/reusable-workflows/.github/workflows/docker-build.yml@{{ $pin }}
    permissions:
      contents: read
      packages: write
      id-token: write
      attestations: write
      artifact-metadata: write
      pull-requests: write
    secrets: inherit
    with:
      prerelease: true
    {{- if ne $ctx "." }}
      context: "{{ $ctx }}"
    {{- end }}
    {{- if not $isRoot }}
      dockerfile: "{{ $c.path }}/{{ $df.path }}"
    {{- else }}
      dockerfile: "{{ $df.path }}"
    {{- end }}
      image_name: "{{ $df.image_name }}"
    {{- if (index $df "platforms") }}
      platforms: "{{ index $df "platforms" }}"
    {{- end }}
      sign: {{`${{ fromJSON(vars.SK_SIGN || 'true') }}`}}
      attest: {{`${{ fromJSON(vars.SK_ATTEST || 'true') }}`}}
      sbom: {{`${{ fromJSON(vars.SK_SBOM || 'true') }}`}}
  scan{{ $suffix }}{{ $imgSuffix }}:
    needs: build{{ $suffix }}{{ $imgSuffix }}
    uses: serverkraken/reusable-workflows/.github/workflows/trivy-image.yml@{{ $pin }}
    permissions:
      contents: read
      security-events: write
      packages: read
      actions: read
    secrets: inherit
    with:
      image_ref: "{{ printf "${{ needs.build%s%s.outputs.image_ref }}" $suffix $imgSuffix }}"
    {{- if (index $df "scanners") }}
      scanners: "{{ index $df "scanners" }}"
    {{- end }}
    {{- /* Ohne dies scannt Trivy bei einem Multi-Arch-Tag nur eine Plattform
         (Vorgabe linux/amd64) — die andere gepushte Architektur bliebe
         ungescannt. Fehlte hier bis zum L-1-Fix, auch im Single-Image-Fall. */}}
    {{- if (index $df "platforms") }}
      platforms: "{{ index $df "platforms" }}"
    {{- else }}
      platforms: linux/amd64,linux/arm64
    {{- end }}
    {{- if (index $df "severity") }}
      severity: "{{ index $df "severity" }}"
    {{- else }}
      severity: {{`${{ vars.SK_TRIVY_SEVERITY || 'HIGH,CRITICAL' }}`}}
    {{- end }}
      trivy_version: {{`${{ vars.SK_TRIVY_VERSION || '' }}`}}
    {{- if has $df "upload_sarif" }}
      upload_sarif: {{ index $df "upload_sarif" }}
    {{- end }}
    {{- if has $df "fail_on_findings" }}
      fail_on_findings: {{ index $df "fail_on_findings" }}
    {{- end }}
{{- end }}

{{- end }}
{{- end }}
{{- if not $any }}
  # Keine Komponente steuert ein Prerelease-Artefakt bei.
  noop:
    runs-on: ubuntu-latest
    steps:
      - run: echo "No on-push prerelease artifacts for this repo."
{{- end }}
