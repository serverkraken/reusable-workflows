{{- /*
  prerelease.yml — manual prerelease image build for service-like components.

  Skipped (file still rendered but empty-jobs) for library/cli roles with no
  dockerfiles: there's nothing to build.

  The job set is decided per component from profile.components[].dockerfiles,
  mirroring release.yml.tmpl's build/scan shape — but prerelease builds every
  Dockerfile regardless of release_eligible (release.yml filters to
  release-eligible-only; prerelease is a manual, throwaway build). Single-
  component components have path="." and emit unsuffixed job names
  (build, scan). Monorepo components emit suffixed job names
  (build-services-api) so multiple components don't collide. The noop job
  (no Dockerfiles at all) is emitted for the first component only, so a
  monorepo never gets two noop jobs.

  The on: block (and the Flutter workflow_dispatch inputs) is still derived
  from the first component only — the Flutter dispatch inputs only make
  sense single-component; a monorepo with an attached Flutter app keeps
  index-0 semantics there.
*/ -}}
{{- $pin := .pin -}}
{{- $c := index .profile.components 0 -}}
name: prerelease
on:
{{- if and (has $c.release_signals "flutter_android") $c.release_signals.flutter_android }}
  workflow_dispatch:
    inputs:
      version:
        description: 'Tag to build (empty → auto <latest>-rc.<run_number>)'
        required: false
        type: string
        default: ''
      prerelease:
        description: 'Mark the GitHub Release as prerelease.'
        type: boolean
        default: true
{{- else }}
  workflow_dispatch: {}
{{- end }}

jobs:
{{- range $i, $c := .profile.components }}
{{- /* Job-ID-sicher: GitHub erlaubt nur [A-Za-z0-9_-]. Ein Pfad wie
     `services/v2.api` ergab ohne diese Bereinigung die Job-ID
     `lint-go-services-v2.api`, und actionlint weist sie zurueck:
     "invalid job ID". GitHub verwirft dann die GANZE Datei, nicht nur
     den Job. Gleiche Bereinigung wie beim $imgSuffix weiter unten. */ -}}
{{- /* Wurzel zuerst pruefen: der Sanitizer wuerde "." zu "-" machen und die
     Wurzelerkennung damit aushebeln. */ -}}
{{- $slug := "" -}}
{{- if ne $c.path "." }}{{ $slug = regexp.Replace "[^A-Za-z0-9_-]" "-" (strings.ReplaceAll "/" "-" $c.path) }}{{ end -}}
{{- $suffix := "" -}}
{{- if $slug }}{{ $suffix = printf "-%s" $slug }}{{ end -}}
{{- $isRoot := eq $c.path "." -}}
{{- if and (has $c.release_signals "flutter_android") $c.release_signals.flutter_android }}
  build{{ $suffix }}:
    uses: serverkraken/reusable-workflows/.github/workflows/release-flutter-android.yml@{{ $pin }}
    secrets: inherit
    with:
      version: {{`${{ inputs.version }}`}}
      create_release: true
      prerelease: {{`${{ inputs.prerelease }}`}}
      dart_define_secret_names: {{`${{ vars.SK_FLUTTER_DART_DEFINE_SECRETS || '' }}`}}
{{- else if gt (len $c.dockerfiles) 0 }}
{{- /* One build+scan pair per Dockerfile — the same shape release.yml.tmpl
     uses, and for the same reason. The multi-image path here used to collapse
     every Dockerfile into ONE docker-build-multi call. That atom exposes no
     per-image outputs, so no scan job could be wired to it, and a component
     with several images pushed all of them to GHCR unscanned while a
     single-image component right next to it was scanned. release.yml was
     already converted; prerelease and prerelease-on-push were not, so the
     hole stayed open on exactly the branch adopters push to most often.

     docker-build-multi still exists for hand-written callers; the renderer no
     longer uses it. */ -}}
{{- range $idx, $df := $c.dockerfiles }}
{{- $imgSuffix := "" }}
{{- if gt (len $c.dockerfiles) 1 }}
  {{- /* Job-ID-safe suffix, identical to release.yml.tmpl: `$` is dropped
       rather than replaced so `$REPO-worker` stays a valid id and no longer
       matches the literal `$REPO` that substituteRepo would rewrite into an
       `owner/repo` string containing a slash. */ -}}
  {{- $base := path.Base $df.image_name -}}
  {{- $base = regexp.Replace "[$]" "" $base -}}
  {{- $base = regexp.Replace "[^A-Za-z0-9_-]" "-" $base -}}
  {{- $imgSuffix = printf "-%s" (strings.ToLower $base) -}}
{{- end }}
{{- $ctx := $c.path }}{{ if (index $df "context") }}{{ $ctx = index $df "context" }}{{ end }}
{{- if gt $idx 0 }}
{{ end }}
  build{{ $suffix }}{{ $imgSuffix }}:
    uses: serverkraken/reusable-workflows/.github/workflows/docker-build.yml@{{ $pin }}
    permissions:
      contents: read
      packages: write
      id-token: write
      attestations: write
      artifact-metadata: write
      pull-requests: write
    secrets: inherit
    with:
      prerelease: true
    {{- if ne $ctx "." }}
      context: {{ $ctx }}
    {{- end }}
    {{- if not $isRoot }}
      dockerfile: {{ $c.path }}/{{ $df.path }}
    {{- else }}
      dockerfile: {{ $df.path }}
    {{- end }}
      image_name: {{ $df.image_name }}
    {{- if (index $df "platforms") }}
      platforms: {{ index $df "platforms" }}
    {{- end }}
      sign: {{`${{ fromJSON(vars.SK_SIGN || 'true') }}`}}
      attest: {{`${{ fromJSON(vars.SK_ATTEST || 'true') }}`}}
      sbom: {{`${{ fromJSON(vars.SK_SBOM || 'true') }}`}}
  scan{{ $suffix }}{{ $imgSuffix }}:
    needs: build{{ $suffix }}{{ $imgSuffix }}
    uses: serverkraken/reusable-workflows/.github/workflows/trivy-image.yml@{{ $pin }}
    permissions:
      contents: read
      security-events: write
      packages: read
      actions: read
    secrets: inherit
    with:
      image_ref: {{ printf "${{ needs.build%s%s.outputs.image_ref }}" $suffix $imgSuffix }}
    {{- /* Emitted only when the manifest sets them — see release.yml.tmpl. */}}
    {{- if (index $df "scanners") }}
      scanners: {{ index $df "scanners" }}
    {{- end }}
    {{- /* Scan the architectures that were actually built. Trivy picks a
         single platform for a multi-arch tag (default linux/amd64), so
         without this the other published arch ships unscanned. */}}
    {{- if (index $df "platforms") }}
      platforms: {{ index $df "platforms" }}
    {{- else }}
      platforms: linux/amd64,linux/arm64
    {{- end }}
    {{- /* A manifest `severity` wins over the repo-wide var: it was written for
         THIS image, and a repo-wide setting overriding it would defeat the
         reason it exists — one image whose threshold has to differ. */}}
    {{- if (index $df "severity") }}
      severity: {{ index $df "severity" }}
    {{- else }}
      severity: {{`${{ vars.SK_TRIVY_SEVERITY || 'HIGH,CRITICAL' }}`}}
    {{- end }}
      trivy_version: {{`${{ vars.SK_TRIVY_VERSION || '' }}`}}
    {{- if has $df "upload_sarif" }}
      upload_sarif: {{ index $df "upload_sarif" }}
    {{- end }}
    {{- /* Scanning and GATING are separate decisions: an image can be worth
         scanning while its findings must not block a release, e.g. CVEs in
         vendored upstream binaries that its own Dockerfile cannot fix. */}}
    {{- if has $df "fail_on_findings" }}
      fail_on_findings: {{ index $df "fail_on_findings" }}
    {{- end }}
{{- end }}

{{- else if eq $i 0 }}
  # No Dockerfiles detected for this component.
  noop:
    runs-on: ubuntu-latest
    steps:
      - run: echo "No prerelease build artifacts for this repo (no Dockerfiles)."
{{- end }}
{{- end }}
