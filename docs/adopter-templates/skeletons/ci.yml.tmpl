{{- /*
  ci.yml — PR-time CI workflow.

  Always emits a `secscan` job (trivy-fs). For each profile component,
  emits per-language lint + test jobs keyed off `primary_language`.
  Job-id pattern: <kind>-<lang>-<suffix>.
  Suffix rule:  path == "."  → "root"
                otherwise    → path with `/` → `-`
  The conditional avoids the naive `replaceAll "." "root"` which would
  mangle paths containing dots (e.g. `services/v2.api`).

  Tunable inputs accept org/repo `vars.SK_*` overrides — see
  docs/operations.md §Per-Adopter Overrides for the full list and how
  to set them. The `||` fallbacks below mirror each atom's `default:`.
*/ -}}
{{- $pin := .pin -}}
name: ci
on:
  pull_request:

jobs:
  secscan:
    uses: serverkraken/reusable-workflows/.github/workflows/trivy-fs.yml@{{ $pin }}
    permissions:
      contents: read
      security-events: write
      actions: read
    with:
      severity: {{`${{ vars.SK_TRIVY_SEVERITY || 'HIGH,CRITICAL' }}`}}
      trivy_version: {{`${{ vars.SK_TRIVY_VERSION || '' }}`}}
{{- if index .profile "gitops" }}
      paths_ignore: |-
        bootstrap/templates
      files_ignore: |-
        secrets.yaml
        config.yaml
        github-deploy.key
        age.key
        secrets.sample.yaml
{{- end }}
    secrets: inherit
{{ range $i, $c := .profile.components }}
{{- $suffix := "" -}}
{{- if eq $c.path "." -}}
{{- $suffix = "root" -}}
{{- else -}}
{{- /* Job-ID-sicher: GitHub erlaubt nur [A-Za-z0-9_-]. Ein Pfad wie
     `services/v2.api` ergab ohne diese Bereinigung die Job-ID
     `lint-go-services-v2.api`, und actionlint weist sie zurueck:
     "invalid job ID". GitHub verwirft dann die GANZE Datei, nicht nur
     den Job. Gleiche Bereinigung wie beim $imgSuffix weiter unten. */ -}}
{{- $suffix = $c.path | replaceAll "/" "-" | regexp.Replace "[^A-Za-z0-9_-]" "-" -}}
{{- end }}
{{- if eq $c.primary_language "go" }}
  lint-go-{{ $suffix }}:
    uses: serverkraken/reusable-workflows/.github/workflows/lint-go.yml@{{ $pin }}
    with:
      working_directory: "{{ $c.path }}"
      go_version: {{`${{ vars.SK_GO_VERSION || '' }}`}}
      golangci_lint_version: {{`${{ vars.SK_GOLANGCI_LINT_VERSION || 'v2.12.2' }}`}}
    {{- if index $c "cgo" }}
      cgo_enabled: {{`${{ fromJSON(vars.SK_CGO_ENABLED || 'true') }}`}}
    {{- else }}
      cgo_enabled: {{`${{ fromJSON(vars.SK_CGO_ENABLED || 'false') }}`}}
    {{- end }}
    secrets: inherit
  test-go-{{ $suffix }}:
    uses: serverkraken/reusable-workflows/.github/workflows/test-go.yml@{{ $pin }}
    with:
      working_directory: "{{ $c.path }}"
      go_version: {{`${{ vars.SK_GO_VERSION || '' }}`}}
      coverage_threshold: {{`${{ fromJSON(vars.SK_COVERAGE_THRESHOLD || '80') }}`}}
    {{- if index $c "cgo" }}
      cgo_enabled: {{`${{ fromJSON(vars.SK_CGO_ENABLED || 'true') }}`}}
    {{- else }}
      cgo_enabled: {{`${{ fromJSON(vars.SK_CGO_ENABLED || 'false') }}`}}
    {{- end }}
    secrets: inherit
{{- else if eq $c.primary_language "python" }}
  lint-python-{{ $suffix }}:
    uses: serverkraken/reusable-workflows/.github/workflows/lint-python.yml@{{ $pin }}
    with:
      working_directory: "{{ $c.path }}"
      python_version: {{`${{ vars.SK_PYTHON_VERSION || '' }}`}}
    secrets: inherit
  test-python-{{ $suffix }}:
    uses: serverkraken/reusable-workflows/.github/workflows/test-python.yml@{{ $pin }}
    with:
      working_directory: "{{ $c.path }}"
      python_version: {{`${{ vars.SK_PYTHON_VERSION || '' }}`}}
      coverage_threshold: {{`${{ fromJSON(vars.SK_COVERAGE_THRESHOLD || '80') }}`}}
    secrets: inherit
{{- else if eq $c.primary_language "rust" }}
  lint-rust-{{ $suffix }}:
    uses: serverkraken/reusable-workflows/.github/workflows/lint-rust.yml@{{ $pin }}
    with:
      working_directory: "{{ $c.path }}"
      rust_toolchain: {{`${{ vars.SK_RUST_TOOLCHAIN || '' }}`}}
      clippy_args: {{`${{ vars.SK_CLIPPY_ARGS || '-D warnings' }}`}}
    secrets: inherit
  test-rust-{{ $suffix }}:
    uses: serverkraken/reusable-workflows/.github/workflows/test-rust.yml@{{ $pin }}
    with:
      working_directory: "{{ $c.path }}"
      rust_toolchain: {{`${{ vars.SK_RUST_TOOLCHAIN || '' }}`}}
      coverage_threshold: {{`${{ fromJSON(vars.SK_COVERAGE_THRESHOLD || '80') }}`}}
      cargo_llvm_cov_version: {{`${{ vars.SK_CARGO_LLVM_COV_VERSION || '0.6.16' }}`}}
    secrets: inherit
{{- else if eq $c.primary_language "helm" }}
{{- /* Chart-component CI (charts_dir + helm-publish dry-run) is a manifest
     feature. A chart repo whose chart merely *sits* in a sub-directory was
     detected as a non-root helm component long before the manifest existed
     and must keep rendering the legacy single lint-helm job byte-identically
     — hence the manifest_sha256 gate rather than a bare `ne $c.path "."`.
     manifest_sha256 is omitempty, so read it with `index`. */ -}}
{{- if or (eq $c.path ".") (not (index $.profile "manifest_sha256")) }}
  lint-helm-{{ $suffix }}:
    uses: serverkraken/reusable-workflows/.github/workflows/lint-helm.yml@{{ $pin }}
    with:
      working_directory: "{{ $c.path }}"
    {{- if index $c "unittest" }}
      unittest: true
    {{- end }}
    secrets: inherit
{{- else }}
  lint-helm-{{ $suffix }}:
    uses: serverkraken/reusable-workflows/.github/workflows/lint-helm.yml@{{ $pin }}
    with:
      working_directory: .
      charts_dir: "{{ $c.path }}"
    {{- if index $c "unittest" }}
      unittest: true
    {{- end }}
    secrets: inherit
  helm-publish-dryrun-{{ $suffix }}:
    uses: serverkraken/reusable-workflows/.github/workflows/helm-publish.yml@{{ $pin }}
    permissions:
      contents: read
      packages: write
    with:
      chart_path: "{{ $c.path }}"
      oci_registry: ghcr.io/{{ index (strings.Split "/" $.profile.target_repo) 0 }}/charts
      dry_run: true
    secrets: inherit
{{- end }}
{{- else if eq $c.primary_language "flutter" }}
  lint-flutter-{{ $suffix }}:
    uses: serverkraken/reusable-workflows/.github/workflows/lint-flutter.yml@{{ $pin }}
    with:
      working_directory: "{{ $c.path }}"
    secrets: inherit
  test-flutter-{{ $suffix }}:
    uses: serverkraken/reusable-workflows/.github/workflows/test-flutter.yml@{{ $pin }}
    with:
      working_directory: "{{ $c.path }}"
      coverage_threshold: {{`${{ fromJSON(vars.SK_COVERAGE_THRESHOLD || '80') }}`}}
    secrets: inherit
{{- else if eq $c.primary_language "gitops" }}
{{- /* Audit J-13: ohne Manifestpfade gar keinen kube-validate-Job rendern.
     Bei leerer Liste entstand `manifests_paths: |-` ohne Inhalt — gueltiges
     YAML mit leerem Wert, von actionlint unbeanstandet, aber der Job scheitert
     zur Laufzeit mit "nichts validiert … unter: ". Erreichbar bei einem
     Bootstrap-only-Repo: `kubernetes/` enthaelt dann nur bootstrap, components
     oder flux-system, und genau die schliesst die Pfadliste aus.
     Der Detektor meldet die Lage als `gitops_without_manifests`. */ -}}
{{- if gt (len $.profile.gitops.manifests_paths) 0 }}
  kube-validate:
    uses: serverkraken/reusable-workflows/.github/workflows/kube-validate.yml@{{ $pin }}
    permissions:
      contents: read
    with:
      manifests_paths: |-
        {{- range $.profile.gitops.manifests_paths }}
        {{ . }}
        {{- end }}
      sops: {{ $.profile.gitops.sops }}
    secrets: inherit
{{- end }}
  kube-lint:
    uses: serverkraken/reusable-workflows/.github/workflows/kube-lint.yml@{{ $pin }}
    permissions:
      contents: read
      security-events: write
      actions: read
    {{- if $.profile.gitops.has_kube_linter_config }}
    with:
      config_path: .kube-linter.yaml
    {{- end }}
    secrets: inherit
  secret-scan:
    uses: serverkraken/reusable-workflows/.github/workflows/secret-scan.yml@{{ $pin }}
    permissions:
      contents: read
      security-events: write
      actions: read
    {{- if $.profile.gitops.has_gitleaks_config }}
    with:
      config_path: .gitleaks.toml
    {{- end }}
    secrets: inherit
{{- end }}
{{- end }}
{{- if index .profile "iac" }}

  tofu-validate:
    uses: serverkraken/reusable-workflows/.github/workflows/tofu-validate.yml@{{ $pin }}
    permissions:
      contents: read
    with:
      working_directories: |-
        {{- range $.profile.iac.directories }}
        {{ . }}
        {{- end }}
      tofu_version: {{`${{ vars.SK_TOFU_VERSION || '' }}`}}
    secrets: inherit
{{`
  # tofu-plan: einkommentieren, sobald ein Remote-Backend konfiguriert ist.
  #
  # OHNE Backend scheitert dieser Job NICHT — er plant gegen einen leeren
  # lokalen State und meldet gruen, ohne irgendetwas zu pruefen. Das ist
  # schlimmer als kein Check, deshalb steht er hier auskommentiert.
  #
  # emit_plan: true legt den (verschluesselten) Plan als Artefakt ab; danach
  # kann tofu-apply.yml ihn per workflow_dispatch mit dieser Run-ID anwenden.
  # Dafuer wird das Secret TF_ENCRYPTION_PASSPHRASE gebraucht.
  #
  # tofu-plan:
  #   uses: serverkraken/reusable-workflows/.github/workflows/tofu-plan.yml@`}}{{ $pin }}{{`
  #   permissions:
  #     contents: read
  #     pull-requests: write
  #   with:
  #     working_directory: tofu
  #     emit_plan: true
  #   secrets: inherit`}}
{{- end }}
{{- if index .profile "shell" }}

  shellcheck:
    uses: serverkraken/reusable-workflows/.github/workflows/lint-shell.yml@{{ $pin }}
    permissions:
      contents: read
      security-events: write
      actions: read
    with:
      paths: |-
        {{- range $.profile.shell.paths }}
        {{ . }}
        {{- end }}
      shellcheck_version: {{`${{ vars.SK_SHELLCHECK_VERSION || '' }}`}}
    secrets: inherit
{{- end }}
