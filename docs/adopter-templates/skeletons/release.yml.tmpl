{{- /*
  release.yml — adopter-rendered release pipeline.

  Composes release-please (via semantic-release.yml) with the build/sign atoms
  the adopter actually needs. The job set is decided per component from
  profile.components[].dockerfiles and release_signals:
    - every release-eligible dockerfile → docker-build.yml + trivy-image.yml
    - release_signals.goreleaser_config → goreleaser.yml
    - release_signals.chart_yaml         → helm-publish.yml

  Single-component and monorepo share the same template body. Single-component
  components have path="." and emit unsuffixed job names (docker-build,
  goreleaser, helm-publish). Monorepo components emit suffixed job names
  (docker-build-services-api) so multiple components don't collide.
*/ -}}
{{- $pin := .pin -}}
{{- $mono := .profile.monorepo -}}
name: release
on:
  push:
    branches: [{{ .profile.default_branch }}]
{{- if and (index .profile "release") (index .profile.release "dispatch_trigger") }}
  workflow_dispatch: {}
{{- end }}

permissions:
  contents: write
  pull-requests: write
  issues: write
  packages: write
  id-token: write
  attestations: write
  artifact-metadata: write
  security-events: write
  actions: read

jobs:
  release-please:
    uses: serverkraken/reusable-workflows/.github/workflows/semantic-release.yml@{{ $pin }}
    secrets: inherit
{{ range $i, $c := .profile.components }}
{{- $slug := strings.ReplaceAll "/" "-" $c.path -}}
{{- if eq $slug "." }}{{ $slug = "" }}{{ end -}}
{{- $suffix := "" -}}
{{- if $slug }}{{ $suffix = printf "-%s" $slug }}{{ end -}}
{{- $ctxPath := $c.path -}}
{{- $isRoot := eq $c.path "." -}}

{{- /* Per-component release gate + image tag. Single-component adopters keep the
     flat release_created/tag_name contract; monorepo adopters gate on the
     component's path appearing in paths_released and take the clean semver from
     releases['<path>'].version (tag_name is prefixed with the package basename). */ -}}
{{- $gate := "needs.release-please.outputs.release_created == 'true'" -}}
{{- $tag := "${{ needs.release-please.outputs.tag_name }}" -}}
{{- /* $ref is the GIT tag for checkouts (docker-build, helm-publish). It differs from $tag:
     monorepo components tag as <package-name>-vX.Y.Z (include-component-in-tag),
     so the image-style "v<version>" string is NOT a checkoutable ref there —
     releases['<path>'].tag_name carries the real tag. */ -}}
{{- $ref := "${{ needs.release-please.outputs.tag_name }}" -}}
{{- if $mono -}}
  {{- $gate = printf "contains(fromJSON(needs.release-please.outputs.paths_released), '%s')" $c.path -}}
  {{- $tag = printf "v${{ fromJSON(needs.release-please.outputs.releases)['%s'].version }}" $c.path -}}
  {{- $ref = printf "${{ fromJSON(needs.release-please.outputs.releases)['%s'].tag_name }}" $c.path -}}
{{- end -}}

{{- /* Filter to release-eligible Dockerfiles only — non-eligible variants (Dockerfile.dev, Dockerfile.debug, …) ship in prerelease.yml only. */ -}}
{{- $releaseDfs := coll.Slice -}}
{{- range $c.dockerfiles -}}
  {{- if .release_eligible -}}
    {{- $releaseDfs = coll.Append . $releaseDfs -}}
  {{- end -}}
{{- end -}}

{{- /* One build+scan pair per release-eligible Dockerfile. The multi-image
     path used to collapse them into a single docker-build-multi call, which
     exposes no per-image outputs — so no scan job could be wired up and those
     images shipped unscanned (mailstack's tools and crowdsec-sync did, while
     its five single-image components were scanned). docker-build-multi still
     exists for hand-written callers; the renderer no longer uses it.

     Job suffix: single-image components keep the bare name so every existing
     adopter renders byte-identically. Only a component with several images
     appends the image's own name, sanitised to what GitHub accepts as a job
     ID — `$` is dropped rather than replaced so `$REPO-worker` stays a valid
     id AND no longer matches the literal `$REPO` that substituteRepo would
     otherwise rewrite into an `owner/repo` string containing a slash. */ -}}
{{- range $idx, $df := $releaseDfs }}
{{- $imgSuffix := "" }}
{{- if gt (len $releaseDfs) 1 }}
  {{- $base := path.Base $df.image_name -}}
  {{- $base = regexp.Replace "[$]" "" $base -}}
  {{- $base = regexp.Replace "[^A-Za-z0-9_-]" "-" $base -}}
  {{- /* Lowercase so the job id matches the image it builds: the `$REPO`
       placeholder is substituted to the lowercase `owner/repo` later, and a
       job called docker-build-REPO next to `image_name: repo` reads like a
       different thing. */ -}}
  {{- $imgSuffix = printf "-%s" (strings.ToLower $base) -}}
{{- end }}
{{- if gt $idx 0 }}
{{ end }}
  docker-build{{ $suffix }}{{ $imgSuffix }}:
    needs: [release-please]
    if: {{ $gate }}
    uses: serverkraken/reusable-workflows/.github/workflows/docker-build.yml@{{ $pin }}
    with:
    {{- $ctx := $ctxPath }}{{ if (index $df "context") }}{{ $ctx = index $df "context" }}{{ end }}
    {{- if ne $ctx "." }}
      context: {{ $ctx }}
    {{- end }}
    {{- if not $isRoot }}
      dockerfile: {{ $ctxPath }}/{{ $df.path }}
    {{- else }}
      dockerfile: {{ $df.path }}
    {{- end }}
      image_name: {{ $df.image_name }}
    {{- if (index $df "platforms") }}
      platforms: {{ index $df "platforms" }}
    {{- end }}
      tag: {{ $tag }}
      ref: {{ $ref }}
      sign: {{`${{ fromJSON(vars.SK_SIGN || 'true') }}`}}
      attest: {{`${{ fromJSON(vars.SK_ATTEST || 'true') }}`}}
      sbom: {{`${{ fromJSON(vars.SK_SBOM || 'true') }}`}}
    secrets: inherit

  scan{{ $suffix }}{{ $imgSuffix }}:
    needs: [docker-build{{ $suffix }}{{ $imgSuffix }}]
    uses: serverkraken/reusable-workflows/.github/workflows/trivy-image.yml@{{ $pin }}
    with:
      image_ref: {{ printf "${{ needs.docker-build%s%s.outputs.image_ref }}" $suffix $imgSuffix }}
    {{- /* Emitted only when the manifest sets them, so adopters that take the
         atom's defaults keep rendering byte-identically. */}}
    {{- if (index $df "scanners") }}
      scanners: {{ index $df "scanners" }}
    {{- end }}
    {{- /* Scan the architectures that were actually built. Trivy picks a
         single platform for a multi-arch tag (default linux/amd64), so
         without this the other published arch ships unscanned. */}}
    {{- if (index $df "platforms") }}
      platforms: {{ index $df "platforms" }}
    {{- else }}
      platforms: linux/amd64,linux/arm64
    {{- end }}
    {{- /* A manifest `severity` wins over the repo-wide var: it was written for
         THIS image, and a repo-wide setting overriding it would defeat the
         reason it exists — one image whose threshold has to differ. */}}
    {{- if (index $df "severity") }}
      severity: {{ index $df "severity" }}
    {{- else }}
      severity: {{`${{ vars.SK_TRIVY_SEVERITY || 'HIGH,CRITICAL' }}`}}
    {{- end }}
      trivy_version: {{`${{ vars.SK_TRIVY_VERSION || '' }}`}}
    {{- if has $df "upload_sarif" }}
      upload_sarif: {{ index $df "upload_sarif" }}
    {{- end }}
    {{- /* Scanning and GATING are separate decisions: an image can be worth
         scanning while its findings must not block a release, e.g. CVEs in
         vendored upstream binaries that its own Dockerfile cannot fix. */}}
    {{- if has $df "fail_on_findings" }}
      fail_on_findings: {{ index $df "fail_on_findings" }}
    {{- end }}
    secrets: inherit
{{- end }}
{{- if $c.release_signals.goreleaser_config }}
  goreleaser{{ $suffix }}:
    needs: [release-please]
    if: {{ $gate }}
    uses: serverkraken/reusable-workflows/.github/workflows/goreleaser.yml@{{ $pin }}
{{- if not $isRoot }}
    with:
      working_directory: {{ $ctxPath }}
{{- end }}
    secrets: inherit
{{- end }}

{{- if $c.release_signals.chart_yaml }}
  helm-publish{{ $suffix }}:
    needs: [release-please]
    if: {{ $gate }}
    uses: serverkraken/reusable-workflows/.github/workflows/helm-publish.yml@{{ $pin }}
    with:
      chart_path: {{ path.Dir $c.release_signals.chart_yaml }}
      oci_registry: ghcr.io/{{ $.profile.target_repo }}/charts
      # Checkout the released tag, not the triggering event's SHA: with
      # back-to-back merges the event SHA predates release-please's bump
      # commit and the job silently republishes the PREVIOUS chart version.
      ref: {{ $ref }}
    secrets: inherit
{{- end }}

{{- /* A chart that is itself a component (manifest-declared `charts/<name>` with
     primary_language helm) publishes from its own path. Root charts keep the
     release_signals.chart_yaml path above; the chart_yaml guard keeps the two
     branches from emitting the same job key twice. Gated on the manifest: a
     detected (manifest-less) chart repo whose chart lives in a sub-directory
     never published from here and must not start now. */ -}}
{{- if and (eq $c.primary_language "helm") (not $isRoot) (not $c.release_signals.chart_yaml) (index $.profile "manifest_sha256") }}
  helm-publish{{ $suffix }}:
    needs: [release-please]
    if: {{ $gate }}
    uses: serverkraken/reusable-workflows/.github/workflows/helm-publish.yml@{{ $pin }}
    permissions:
      contents: read
      packages: write
    with:
      chart_path: {{ $c.path }}
      oci_registry: ghcr.io/{{ index (strings.Split "/" $.profile.target_repo) 0 }}/charts
      ref: {{ $ref }}
    secrets: inherit
{{- end }}

{{- if and (has $c.release_signals "flutter_android") $c.release_signals.flutter_android }}
  release-flutter-android{{ $suffix }}:
    needs: [release-please]
    if: {{ $gate }}
    uses: serverkraken/reusable-workflows/.github/workflows/release-flutter-android.yml@{{ $pin }}
    with:
    {{- if not $isRoot }}
      working_directory: {{ $ctxPath }}
    {{- end }}
      version: {{ $tag }}
      dart_define_secret_names: {{`${{ vars.SK_FLUTTER_DART_DEFINE_SECRETS || '' }}`}}
    secrets: inherit
{{- end }}
{{ end }}
{{- /* Manifest `release.chart_pins`: after the images are actually pushed,
     pin them in the chart that ships in the same repo. `needs:` the build
     jobs is the whole point — a pin that moves ahead of a ~25 min multi-arch
     build leaves the cluster in ImagePullBackOff (mailstack, v1.6.2). The
     builds of components that did not release are skipped, so the job needs
     `!cancelled()` to run at all, and the atom bumps only what is present in
     `releases`. */ -}}
{{- if and (index .profile "release") (index .profile.release "chart_pins") }}
{{- $buildJobs := coll.Slice "release-please" -}}
{{- $imageMap := coll.Dict -}}
{{- range $c := .profile.components -}}
  {{- $slug := strings.ReplaceAll "/" "-" $c.path -}}
  {{- if eq $slug "." }}{{ $slug = "" }}{{ end -}}
  {{- $sfx := "" -}}
  {{- if $slug }}{{ $sfx = printf "-%s" $slug }}{{ end -}}
  {{- $dfs := coll.Slice -}}
  {{- range $c.dockerfiles -}}{{- if .release_eligible -}}{{- $dfs = coll.Append . $dfs -}}{{- end -}}{{- end -}}
  {{- if gt (len $dfs) 0 -}}
    {{- $names := coll.Slice -}}
    {{- range $df := $dfs -}}
      {{- $names = coll.Append $df.image_name $names -}}
      {{- $imgSuffix := "" -}}
      {{- if gt (len $dfs) 1 -}}
        {{- $base := regexp.Replace "[^A-Za-z0-9_-]" "-" (regexp.Replace "[$]" "" (path.Base $df.image_name)) -}}
        {{- $imgSuffix = printf "-%s" (strings.ToLower $base) -}}
      {{- end -}}
      {{- $buildJobs = coll.Append (printf "docker-build%s%s" $sfx $imgSuffix) $buildJobs -}}
    {{- end -}}
    {{- $imageMap = coll.Merge $imageMap (coll.Dict $c.path $names) -}}
  {{- end -}}
{{- end }}
  chart-image-pins:
    needs: [{{ join $buildJobs ", " }}]
    {{- /* `!failure()` is the load-bearing half, `!cancelled()` the permissive
         one. Builds of components that did NOT release are skipped, so a bare
         success() gate would never let this job run — but `!cancelled()` alone
         also passes when a build FAILED, and the job would then pin the chart
         to a tag that was never pushed. That is the exact ImagePullBackOff the
         `needs:` above exists to prevent (mailstack, v1.6.2). `!failure()` is
         false as soon as any needed job failed, while skipped ones still pass.

         One expression, not a mix: text outside ${{ }} makes the whole
         condition constant-true, which actionlint rejects. */}}
    if: {{`${{ !failure() && !cancelled() && needs.release-please.outputs.paths_released != '[]' }}`}}
    uses: serverkraken/reusable-workflows/.github/workflows/chart-image-bump.yml@{{ $pin }}
    permissions:
      contents: write
    with:
      values_file: {{ .profile.release.chart_pins.values }}
      key_template: {{ .profile.release.chart_pins.key }}
      images: |
        {{ $imageMap | toJSON }}
      releases: {{`${{ needs.release-please.outputs.releases }}`}}
    secrets: inherit
{{- /* Blank line as action output, not literal text: the next construct's
     `{{-` trims literal whitespace greedily, so a plain empty line here would
     vanish and glue this block onto the following job. */}}
{{- "\n" -}}
{{- end }}
{{- /* Manifest `release.badges: true`: after anything was released, rewrite
     the README badge block + table and commit it ([skip ci]). */ -}}
{{- if and (index .profile "release") (index .profile.release "badges") }}
  version-badges:
    needs: [release-please]
    if: needs.release-please.outputs.paths_released != '[]'
    uses: serverkraken/reusable-workflows/.github/workflows/version-badges.yml@{{ $pin }}
    permissions:
      contents: write
    secrets: inherit
{{- end }}
