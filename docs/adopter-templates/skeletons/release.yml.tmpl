{{- /*
  release.yml — adopter-rendered release pipeline.

  Composes release-please (via semantic-release.yml) with the build/sign atoms
  the adopter actually needs. The job set is decided per component from
  profile.components[].dockerfiles and release_signals:
    - dockerfiles[] of length 1   → docker-build.yml
    - dockerfiles[] of length >1  → docker-build-multi.yml
    - release_signals.goreleaser_config → goreleaser.yml
    - release_signals.chart_yaml         → helm-publish.yml

  Single-component and monorepo share the same template body. Single-component
  components have path="." and emit unsuffixed job names (docker-build,
  goreleaser, helm-publish). Monorepo components emit suffixed job names
  (docker-build-services-api) so multiple components don't collide.
*/ -}}
{{- $pin := .pin -}}
{{- $mono := .profile.monorepo -}}
name: release
on:
  push:
    branches: [{{ .profile.default_branch }}]
{{- if and (index .profile "release") (index .profile.release "dispatch_trigger") }}
  workflow_dispatch: {}
{{- end }}

permissions:
  contents: write
  pull-requests: write
  issues: write
  packages: write
  id-token: write
  attestations: write
  artifact-metadata: write
  security-events: write
  actions: read

jobs:
  release-please:
    uses: serverkraken/reusable-workflows/.github/workflows/semantic-release.yml@{{ $pin }}
    secrets: inherit
{{ range $i, $c := .profile.components }}
{{- $slug := strings.ReplaceAll "/" "-" $c.path -}}
{{- if eq $slug "." }}{{ $slug = "" }}{{ end -}}
{{- $suffix := "" -}}
{{- if $slug }}{{ $suffix = printf "-%s" $slug }}{{ end -}}
{{- $ctxPath := $c.path -}}
{{- $isRoot := eq $c.path "." -}}

{{- /* Per-component release gate + image tag. Single-component adopters keep the
     flat release_created/tag_name contract; monorepo adopters gate on the
     component's path appearing in paths_released and take the clean semver from
     releases['<path>'].version (tag_name is prefixed with the package basename). */ -}}
{{- $gate := "needs.release-please.outputs.release_created == 'true'" -}}
{{- $tag := "${{ needs.release-please.outputs.tag_name }}" -}}
{{- if $mono -}}
  {{- $gate = printf "contains(fromJSON(needs.release-please.outputs.paths_released), '%s')" $c.path -}}
  {{- $tag = printf "v${{ fromJSON(needs.release-please.outputs.releases)['%s'].version }}" $c.path -}}
{{- end -}}

{{- /* Filter to release-eligible Dockerfiles only — non-eligible variants (Dockerfile.dev, Dockerfile.debug, …) ship in prerelease.yml only. */ -}}
{{- $releaseDfs := coll.Slice -}}
{{- range $c.dockerfiles -}}
  {{- if .release_eligible -}}
    {{- $releaseDfs = coll.Append . $releaseDfs -}}
  {{- end -}}
{{- end -}}

{{- if eq (len $releaseDfs) 1 }}
{{- $df := index $releaseDfs 0 }}
  docker-build{{ $suffix }}:
    needs: [release-please]
    if: {{ $gate }}
    uses: serverkraken/reusable-workflows/.github/workflows/docker-build.yml@{{ $pin }}
    with:
    {{- $ctx := $ctxPath }}{{ if (index $df "context") }}{{ $ctx = index $df "context" }}{{ end }}
    {{- if ne $ctx "." }}
      context: {{ $ctx }}
    {{- end }}
    {{- if not $isRoot }}
      dockerfile: {{ $ctxPath }}/{{ $df.path }}
    {{- else }}
      dockerfile: {{ $df.path }}
    {{- end }}
      image_name: {{ $df.image_name }}
    {{- if (index $df "platforms") }}
      platforms: {{ index $df "platforms" }}
    {{- end }}
      tag: {{ $tag }}
      sign: {{`${{ fromJSON(vars.SK_SIGN || 'true') }}`}}
      attest: {{`${{ fromJSON(vars.SK_ATTEST || 'true') }}`}}
      sbom: {{`${{ fromJSON(vars.SK_SBOM || 'true') }}`}}
    secrets: inherit

  scan{{ $suffix }}:
    needs: [docker-build{{ $suffix }}]
    uses: serverkraken/reusable-workflows/.github/workflows/trivy-image.yml@{{ $pin }}
    with:
      image_ref: {{ printf "${{ needs.docker-build%s.outputs.image_ref }}" $suffix }}
      severity: {{`${{ vars.SK_TRIVY_SEVERITY || 'HIGH,CRITICAL' }}`}}
      trivy_version: {{`${{ vars.SK_TRIVY_VERSION || '' }}`}}
    secrets: inherit
{{- else if gt (len $releaseDfs) 1 -}}
{{/* Translate profile.json's dockerfiles[{path, image_name, ...}] into the
     docker-build-multi atom's expected shape: [{dockerfile, image_name}]. */}}
{{- $images := coll.Slice -}}
{{- range $releaseDfs -}}
  {{- $dfPath := .path -}}
  {{- if not $isRoot -}}{{- $dfPath = printf "%s/%s" $ctxPath .path -}}{{- end -}}
  {{- $images = coll.Append (coll.Dict "dockerfile" $dfPath "image_name" .image_name) $images -}}
{{- end }}
  docker-build{{ $suffix }}:
    needs: [release-please]
    if: {{ $gate }}
    uses: serverkraken/reusable-workflows/.github/workflows/docker-build-multi.yml@{{ $pin }}
    with:
    {{- $ctx := $ctxPath }}{{ if (index (index $releaseDfs 0) "context") }}{{ $ctx = index (index $releaseDfs 0) "context" }}{{ end }}
    {{- if ne $ctx "." }}
      context: {{ $ctx }}
    {{- end }}
      images: |
        {{ $images | toJSON }}
    {{- /* detect enforces one platforms value across a component's Dockerfiles
         (docker-build-multi has a single platforms input), so index 0 speaks
         for all of them. */ -}}
    {{- if (index (index $releaseDfs 0) "platforms") }}
      platforms: {{ index (index $releaseDfs 0) "platforms" }}
    {{- end }}
      tag: {{ $tag }}
      sign: {{`${{ fromJSON(vars.SK_SIGN || 'true') }}`}}
      attest: {{`${{ fromJSON(vars.SK_ATTEST || 'true') }}`}}
      sbom: {{`${{ fromJSON(vars.SK_SBOM || 'true') }}`}}
    secrets: inherit
{{- end }}

{{- if $c.release_signals.goreleaser_config }}
  goreleaser{{ $suffix }}:
    needs: [release-please]
    if: {{ $gate }}
    uses: serverkraken/reusable-workflows/.github/workflows/goreleaser.yml@{{ $pin }}
{{- if not $isRoot }}
    with:
      working_directory: {{ $ctxPath }}
{{- end }}
    secrets: inherit
{{- end }}

{{- if $c.release_signals.chart_yaml }}
  helm-publish{{ $suffix }}:
    needs: [release-please]
    if: {{ $gate }}
    uses: serverkraken/reusable-workflows/.github/workflows/helm-publish.yml@{{ $pin }}
    with:
      chart_path: {{ path.Dir $c.release_signals.chart_yaml }}
      oci_registry: ghcr.io/{{ $.profile.target_repo }}/charts
    secrets: inherit
{{- end }}

{{- /* A chart that is itself a component (manifest-declared `charts/<name>` with
     primary_language helm) publishes from its own path. Root charts keep the
     release_signals.chart_yaml path above; the chart_yaml guard keeps the two
     branches from emitting the same job key twice. Gated on the manifest: a
     detected (manifest-less) chart repo whose chart lives in a sub-directory
     never published from here and must not start now. */ -}}
{{- if and (eq $c.primary_language "helm") (not $isRoot) (not $c.release_signals.chart_yaml) (index $.profile "manifest_sha256") }}
  helm-publish{{ $suffix }}:
    needs: [release-please]
    if: {{ $gate }}
    uses: serverkraken/reusable-workflows/.github/workflows/helm-publish.yml@{{ $pin }}
    permissions:
      contents: read
      packages: write
    with:
      chart_path: {{ $c.path }}
      oci_registry: ghcr.io/{{ index (strings.Split "/" $.profile.target_repo) 0 }}/charts
    secrets: inherit
{{- end }}

{{- if and (has $c.release_signals "flutter_android") $c.release_signals.flutter_android }}
  release-flutter-android{{ $suffix }}:
    needs: [release-please]
    if: {{ $gate }}
    uses: serverkraken/reusable-workflows/.github/workflows/release-flutter-android.yml@{{ $pin }}
    with:
    {{- if not $isRoot }}
      working_directory: {{ $ctxPath }}
    {{- end }}
      version: {{ $tag }}
      dart_define_secret_names: {{`${{ vars.SK_FLUTTER_DART_DEFINE_SECRETS || '' }}`}}
    secrets: inherit
{{- end }}
{{ end }}
{{- /* Manifest `release.badges: true`: after anything was released, rewrite
     the README badge block + table and commit it ([skip ci]). */ -}}
{{- if and (index .profile "release") (index .profile.release "badges") }}
  version-badges:
    needs: [release-please]
    if: needs.release-please.outputs.paths_released != '[]'
    uses: serverkraken/reusable-workflows/.github/workflows/version-badges.yml@{{ $pin }}
    permissions:
      contents: write
    secrets: inherit
{{- end }}
