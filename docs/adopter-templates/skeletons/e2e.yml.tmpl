{{- /*
  e2e.yml — consumer-owned Kubernetes e2e suite on a kind cluster, rendered
  only when the adopter manifest declares workflows.e2e. The script owns the
  cluster lifecycle; e2e-kind.yml provisions the toolchain and guarantees
  cleanup on the long-lived self-hosted runners.
*/ -}}
{{- $pin := .pin -}}
{{- $e2e := .profile.workflows.e2e -}}
name: e2e
on:
{{- if index $e2e "schedule" }}
  schedule:
    - cron: '{{ index $e2e "schedule" }}'
{{- end }}
  workflow_dispatch: {}
  push:
    tags:
      # Full semver only. semantic-release also pushes the floating tags
      # (v1, v1.2) for every release; with 'v*' one release started three
      # identical e2e runs that starved each other on the performance pool
      # (mailstack, 2026-08-21: all three died in the Cilium setup timeout).
      # Component tags (postfix-v1.2.0) do not match either — only a root
      # release exercises the stack.
      - 'v*.*.*'

# One e2e at a time: a run claims the performance pool exclusively enough
# that parallel runs eat each other's wait budgets. No cancel-in-progress —
# a running suite finishes, newer ones queue behind it.
concurrency:
  group: e2e-kind
  cancel-in-progress: false

jobs:
  e2e:
    uses: serverkraken/reusable-workflows/.github/workflows/e2e-kind.yml@{{ $pin }}
    permissions:
      contents: read
      packages: read
    with:
      script: {{ $e2e.script }}
      helm_version: {{`${{ vars.SK_HELM_VERSION || 'v3.16.3' }}`}}
    secrets: inherit
