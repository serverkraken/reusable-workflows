{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "bump-minor-pre-major": true,
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Refactors" },
    { "type": "docs", "section": "Documentation", "hidden": false },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true }
  ],
  "packages": {
{{- /* Every commit reaches the root package unless it is excluded, so a
     `fix(api): …` touching only services/api would release the root too.
     exclude-paths lists every non-root component path to keep the root
     release honest. Emitted only when there is a non-root component. */ -}}
{{- $nonRoot := coll.Slice -}}
{{- range .profile.components -}}
  {{- if ne .path "." -}}
    {{- $nonRoot = coll.Append .path $nonRoot -}}
  {{- end -}}
{{- end }}
{{- $first := true }}
{{- range .profile.components }}
{{- if not $first }},{{ end }}
{{- $first = false }}
{{- if eq .path "." }}
    ".": {
      "release-type": "{{ .release_please_type }}",
{{- if gt (len $nonRoot) 0 }}
      "exclude-paths": [{{ range $i, $p := $nonRoot }}{{ if $i }}, {{ end }}{{ printf "%q" $p }}{{ end }}],
{{- end }}
      "include-component-in-tag": false
    }
{{- else }}
    "{{ .path }}": {
      "release-type": "{{ .release_please_type }}",
      "package-name": "{{ path.Base .path }}",
{{- /* Manifest `app_version: true`: release-please's helm strategy rewrites
     only `version:`, so a chart's appVersion otherwise freezes at whatever it
     held when the chart became its own package — and that stale value is what
     app.kubernetes.io/version and the install notes show. The generic updater
     picks up the x-release-please-version marker on the appVersion line.

     The path is relative to the PACKAGE, not to the repo root. Spelling it
     from the root made release-please look for
     charts/mailstack/charts/mailstack/Chart.yaml, log "did not exist" and
     move on — the release still went out, with appVersion untouched.

     Same two cases release.yml.tmpl distinguishes for helm-publish: a
     manifest-declared chart component carries no release_signals.chart_yaml
     and holds its Chart.yaml at its own root, while a detected chart names
     the file explicitly and may keep it in a sub-directory. */}}
{{- if (index . "app_version") }}
{{- $chartRel := "Chart.yaml" }}
{{- if .release_signals.chart_yaml }}{{ $chartRel = strings.TrimPrefix (printf "%s/" .path) .release_signals.chart_yaml }}{{ end }}
      "extra-files": [{ "type": "generic", "path": "{{ $chartRel }}" }],
{{- end }}
      "include-component-in-tag": true
    }
{{- end }}
{{- end }}
  }
}
